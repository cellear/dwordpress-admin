{#
/**
 * @file
 * The WordPress-style admin bar.
 *
 * Variables: logo_menu (links), site {name, url, links}, comments {count, url, label}|null,
 * new (links), user {name, initial, links}. Dropdowns open on hover / focus (CSS only).
 */
#}
<div id="wp-admin-bar" class="wp-admin-bar" data-offset-top role="navigation" aria-label="{{ 'Admin bar'|t }}">
  <ul class="wp-admin-bar__menu">
    <li class="wp-admin-bar__item wp-admin-bar__item--logo wp-admin-bar__item--has-menu">
      <a class="wp-admin-bar__link" href="{{ logo_menu.0.url.toString() }}" aria-label="{{ 'About Drupal'|t }}"><span class="wp-admin-bar__logo" aria-hidden="true">D</span></a>
      <ul class="wp-admin-bar__submenu">
        {% for link in logo_menu %}<li><a href="{{ link.url.toString() }}">{{ link.title }}</a></li>{% endfor %}
      </ul>
    </li>
    <li class="wp-admin-bar__item wp-admin-bar__item--site wp-admin-bar__item--has-menu">
      <a class="wp-admin-bar__link" href="{{ site.url.toString() }}"><span class="wp-admin-bar__icon" aria-hidden="true">⌂</span>{{ site.name }}</a>
      <ul class="wp-admin-bar__submenu">
        {% for link in site.links %}<li><a href="{{ link.url.toString() }}">{{ link.title }}</a></li>{% endfor %}
      </ul>
    </li>
    {% if comments %}
      <li class="wp-admin-bar__item wp-admin-bar__item--comments">
        <a class="wp-admin-bar__link" href="{{ comments.url.toString() }}" title="{{ comments.label }}"><span class="wp-admin-bar__icon" aria-hidden="true">🗨</span><span class="wp-admin-bar__count{% if comments.count %} wp-admin-bar__count--pending{% endif %}">{{ comments.count }}</span><span class="visually-hidden">{{ comments.label }}</span></a>
      </li>
    {% endif %}
    {% if new %}
      <li class="wp-admin-bar__item wp-admin-bar__item--new wp-admin-bar__item--has-menu">
        <a class="wp-admin-bar__link" href="{{ new.0.url.toString() }}"><span class="wp-admin-bar__icon" aria-hidden="true">+</span>{{ 'New'|t }}</a>
        <ul class="wp-admin-bar__submenu">
          {% for link in new %}<li><a href="{{ link.url.toString() }}">{{ link.title }}</a></li>{% endfor %}
        </ul>
      </li>
    {% endif %}
  </ul>
  <ul class="wp-admin-bar__menu wp-admin-bar__menu--secondary">
    <li class="wp-admin-bar__item wp-admin-bar__item--account wp-admin-bar__item--has-menu">
      <a class="wp-admin-bar__link" href="{{ user.links.0.url.toString() }}">{{ 'Howdy, @name'|t({'@name': user.name}) }}<span class="wp-admin-bar__avatar" aria-hidden="true">{{ user.initial }}</span></a>
      <ul class="wp-admin-bar__submenu wp-admin-bar__submenu--right">
        {% for link in user.links %}<li><a href="{{ link.url.toString() }}">{{ link.title }}</a></li>{% endfor %}
      </ul>
    </li>
  </ul>
</div>
