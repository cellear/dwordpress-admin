{# Dashboard layout: the full-width welcome panel, then two independent columns of cards.
   panels: list of {id, title, body, wide, column (0 = full width, 1 = left, 2 = right)}. #}
<div class="wp-admin-dashboard">
  {% for panel in panels|filter(p => p.column == 0) %}
    <div class="wp-admin-dashboard__welcome" id="wp-admin-{{ panel.id }}">{{ panel.body }}</div>
  {% endfor %}
  {% for col in [1, 2] %}
    <div class="wp-admin-dashboard__col">
      {% for panel in panels|filter(p => p.column == col) %}
        <div class="wp-admin-card" id="wp-admin-{{ panel.id }}">
          <h2 class="wp-admin-card__title">{{ panel.title }}</h2>
          <div class="wp-admin-card__body">{{ panel.body }}</div>
        </div>
      {% endfor %}
    </div>
  {% endfor %}
</div>
