<?php

/**
 * @file
 * WordPress-style admin: theme hooks, sidebar tweaks and the top admin bar.
 */

use Drupal\Core\Session\AccountInterface;
use Drupal\Core\Url;

/**
 * Implements hook_theme().
 */
function wp_admin_theme(): array {
  return [
    'wp_admin_page' => [
      'variables' => ['page' => [], 'extra' => []],
      'template' => 'wp-admin-page',
    ],
    'wp_admin_dashboard' => [
      'variables' => ['panels' => []],
      'template' => 'wp-admin-dashboard',
    ],
    'wp_admin_top_bar' => [
      'variables' => ['logo_menu' => [], 'site' => [], 'comments' => NULL, 'new' => [], 'user' => []],
      'template' => 'wp-admin-top-bar',
    ],
  ];
}

/**
 * Implements hook_library_info_alter().
 *
 * Appends the WordPress color scheme to the Navigation module's own stylesheet
 * so it loads after core's rules wherever the sidebar is rendered.
 */
function wp_admin_library_info_alter(array &$libraries, string $extension): void {
  if ($extension === 'navigation' && isset($libraries['internal.navigation'])) {
    $path = '/' . \Drupal::service('extension.list.module')->getPath('wp_admin') . '/css/wp-admin-navigation.css';
    $libraries['internal.navigation']['css']['theme'][$path] = ['weight' => 10];
  }
}

/**
 * Implements hook_navigation_content_top_alter().
 *
 * Drops Umami's "This site is intended for demonstration purposes" notice from
 * the sidebar; WordPress has nothing like it there.
 */
function wp_admin_navigation_content_top_alter(array &$content_top): void {
  unset($content_top['experimental-profile-warning']);
}

/**
 * Implements hook_page_top().
 *
 * The WordPress admin bar: a 32px black bar on every page for users who can
 * see the Navigation sidebar.
 */
function wp_admin_page_top(array &$page_top): void {
  $account = \Drupal::currentUser();
  if (!$account->hasPermission('access navigation')) {
    return;
  }
  $page_top['wp_admin_top_bar'] = [
    '#lazy_builder' => ['wp_admin.top_bar:build', []],
    '#create_placeholder' => TRUE,
    '#cache' => ['contexts' => ['user.permissions']],
  ];
}

/**
 * Implements hook_user_login().
 *
 * WordPress lands on the dashboard after login; so do users of the
 * WordPress-style admin, unless the request already names a destination.
 */
function wp_admin_user_login(AccountInterface $account): void {
  $request = \Drupal::request();
  if (!$request->query->has('destination') && $account->hasPermission('access navigation')) {
    // The redirect subscriber reads the request query; the destination service
    // keeps its own copy, so set both.
    $url = Url::fromRoute('wp_admin.dashboard')->toString();
    $request->query->set('destination', $url);
    \Drupal::destination()->set($url);
  }
}

/**
 * Implements hook_page_attachments().
 *
 * Keeps the sidebar expanded on desktop (WordPress never shows icons only).
 * Attached here, not on the top bar placeholder, so the header library really
 * lands in <head> before core's inline sidebar script.
 */
function wp_admin_page_attachments(array &$attachments): void {
  $attachments['#cache']['contexts'][] = 'user.permissions';
  if (\Drupal::currentUser()->hasPermission('access navigation')) {
    $attachments['#attached']['library'][] = 'wp_admin/sidebar';
    $attachments['#attached']['library'][] = 'wp_admin/menu';
  }
}
